---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

import '../styles/_base.scss';
import '../styles/_animations.scss';
import '../styles/_vendor.scss';

type Props = CollectionEntry<'projects'>['data'];

const { heading, description, image, skills, link, github } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={heading} description={description} />
	</head>
	<body>
		<main>
      <Header />
			<article>
        <header>
          <h1>{heading}</h1>
          <aside>
            {description}&nbsp;
            {github && <a href={github} target="_blank">View on Github</a>}
          </aside>
        </header>
        <br />
        <me-project-figure>
          {(image && !link) && <img width={1020} height={510} src={image} alt={heading} />}
          {(image && link) && <a href={link} target="_blank"><img src={image} alt={heading} /></a>}
        </me-project-figure>
        <me-project-skills>
          <span>Skill used on this projects:</span>
          <ul>
            {skills && skills.map((skill: unknown) => (
              <li><em>{skill}</em>,</li>
            ))}
          </ul>
        </me-project-skills>
        <slot />
			</article>
		</main>
		<Footer />
	</body>
  <style>
    article {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 2rem;
    }

    ul {
      list-style: none;
      padding: 0;
      margin: 2rem 0;
      display: inline-flex;
      gap: 0.5rem;
    }

    em {
      opacity: 0.7;
    }

  </style>
  <script>
    import '../elements/waves';
  </script>
</html>
