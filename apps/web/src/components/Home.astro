---
import LatestBlogPosts from '../components/LatestBlogPosts.astro';
const numberOfPostToDisplay = 3;
---
<deific-cta>
  <kemet-button link="/consultation" rounded="pill">Contact me to get started</kemet-button>
</deific-cta>
<deific-socials></deific-socials>
<deific-home class="page">
  <div>
    <img src="/techankh.png" width="379" height="589" alt="Tech Ankh logo" />
    <svg id="logo" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink"  x="0px" y="0px" fill="currentColor" viewBox="0 0 1388 266" style="enable-background:new 0 0 1388 266;" xml:space="preserve">
    <g id="Deific_Arts">
      <path d="M542.09,226.38h24v-38.4h43.4v-18.8h-43.4v-27.2h80.4v-18.8h-104.4V226.38z M135.95,0.41H0v11.33 c32.88,5.63,35.18,9.97,35.18,28.36v188.13c0,14.29-12.78,22.62-33.92,24.61V266h14.5c16.49-0.35,43.54-0.86,62.18-0.86h40.8 c117.98,0,204.98-51.99,204.98-142.48C323.73,32.56,233.28,0.41,135.95,0.41z M118.75,247.28H85.81c0,0,2.46-10.32,2.46-22.23 V22.64l5.41-4.37h41.29c84.55,0,129.77,46.04,129.77,114.7C264.74,200.84,220.99,247.28,118.75,247.28z M656.28,226.38h24v-103.2 h-24V226.38z M485.29,226.38h24v-103.2h-24V226.38z M378.29,181.38h47.6v-17.6h-47.6v-23h81.6v-17.6h-105.6v103.2h106.6v-18.8 h-82.6V181.38z M1378.07,169.18c-5-4.8-13.8-5-20.2-5h-64.2v-22.2h67.4v11.8l21.2-5v-3c0-3.6-0.2-12.4-5.2-17.4 c-4.8-4.6-14-5.2-19-5.2h-62.2c-4.2,0-13,0.4-17.8,4.8c-5.6,5.2-5.6,15.2-5.6,19.6v11c0,4.4,0,14.4,5.6,19.6 c4.8,4.4,14,4.8,17.6,4.8h66.8v24.6h-73v-12.2l-21.2,4.4v2.2c0,4.4,0,14,5.6,19.4c5,4.8,14,5,18.4,5h68.6c3.2,0,12.2-0.4,17.2-5 c3.8-3.6,5.6-10.4,5.6-16.6v-18.6C1383.67,179.38,1381.87,172.78,1378.07,169.18z M798.08,123.18h-61.6c-6.6,0-15,0.2-20,5 c-5.6,5.4-5.6,15-5.6,19.4v54.4c0,4.4,0,14,5.6,19.4c5,4.8,13.4,5,20,5h61.6c6.6,0,15-0.2,20-5c5.6-5.4,5.6-15,5.6-19.4v-11.8 l-24-5v22.4h-64.8v-65.6h64.8v19.6l24-3.8v-10.2c0-4.4,0-14-5.6-19.4C813.08,123.38,804.68,123.18,798.08,123.18z M1146.28,141.98h47.4v84.4h24v-84.4h47.4v-18.8h-118.8V141.98z M1113.07,187.38c4.6,0,12.8-0.4,17.6-4.6c2.8-2.4,5.6-7,5.6-15 v-24.6c0-4.2-0.4-11.2-6.2-15.8c-4.8-3.8-12.2-4.2-17-4.2h-89v103.2h24v-39h22.6l41.6,39h34.4l-47.6-39H1113.07z M1048.08,169.78 v-29h54.6c1,0,5,0,7,1.6c2.6,2,2.6,5,2.6,6.6v12.6c0,1.6,0,4.6-2.6,6.6c-1.8,1.2-5,1.6-6.6,1.6H1048.08z M923.48,123.18 l-58.4,103.2h24.2l11.8-22.4h65.6l12.2,22.4h27l-59.2-103.2H923.48z M910.88,185.18l23.2-42l22.4,42H910.88z"></path>
    </g>
    </svg>
    <p>
      <kemet-button link="/started" rounded="pill">Contact me to get started</kemet-button>
      &nbsp;&nbsp;&nbsp;&nbsp;
      <kemet-button link="/about" variant="outlined" rounded="pill" polarity="dark">Learn more about me</kemet-button>
    </p>
  </div>
</deific-home>
<deific-about class="page">
  <div class="about">
      <img src="/assets/hasanirogers.webp" alt="Hasani Rogers, owner of Deific Arts, LLC">
      <div>
        <h2>I BUILD</h2>
        <deific-builds></deific-builds>
      </div>
  </div>
  <div class="description">
    <p>
     My name is Hasani and I'm a full-stack developer with a creative edge. This means that not only can I build your site or app, but I can also help you with your marketing and branding. Think of me as a partner who can help you build and grow your business online. I have over 20 years of industry experience and I use that to help small businesses flourish online.
    </p>
  </div>
</deific-about>
<deific-skills class="page">Skills</deific-skills>
<LatestBlogPosts postsToShow={numberOfPostToDisplay} />
<deific-consultation url="https://calendly.com/contact-deificarts/consultation" class="page"></deific-consultation>
<deific-background></deific-background>
<style>
  deific-cta {
    position: fixed;
    top: 2rem;
    right: 2rem;
    z-index: 9999;

    kemet-button {
      --kemet-button-background-color: var(--color-primary);
      font-weight: bold;
      text-transform: uppercase;
      text-shadow: 1px 1px #000000aa;
    }
  }

  deific-home {
    flex-direction: column;
  }

  deific-about {
    & > * {
      margin: 0 auto;
      max-width: 1280px;
    }

    h2 {
      font-size: 2rem;
      opacity: 0.5;
      margin: 0;
      padding: 0;
      letter-spacing: 2px;
    }

    img {
      width: 150px;
      height: 150px;
      border-radius: 50%;
      object-fit: cover;
    }

    /* deific-builds {
      display: block;
      font-size: 3rem;
      font-weight: bold;
      text-transform: uppercase;
      line-height: 1.1;
      opacity: 1;
      text-align: left;
    } */

    .Typewriter__cursor {
      color: var(--color-primary);
    }
  }

  deific-consultation {
    z-index: 999;

    @media screen and (width > 768px) {
      z-index: 1;
    }
  }

  .page {
    display: flex;
    padding: 1rem;
    width: 100%;
    height: calc(100vh - 230px);
    scroll-snap-align: start;
    text-align: center;
    position: relative;

    & > * {
      width: 100%;
      height: 100%;
      margin: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      @media (min-width: 1024px) {
        padding: 2rem;
      }
    }

    h2 {
      font-size: clamp(1rem, 5vw, 2rem);
      white-space: nowrap;
      margin: 0;
      line-height: 1;

      span {
        display: block;
        font-size: 0.5em;
        opacity: 0.5;
      }
    }
  }

  deific-about.page {
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;

    ul {
      display: flex;
      gap: 1rem;
      list-style: none;
      margin: 0;
      padding: 0;
      flex-wrap: wrap;
    }

    .description {
      font-size: 1.25rem;
      text-align: left;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-start;
    }

    .about {
      flex-direction: row;
      justify-content: flex-start;
      align-items: center;
      gap: 1.5rem;

      width: 100%;
      height: auto;
      margin: 0 auto;
      font-size: 2rem;
      text-align: left;
      flex-direction: column;
      justify-content: center;

      @media screen and (min-width: 769px) {
        flex-direction: row;
        justify-content: flex-start
      }
    }
  }

  #logo {
    width: 66%;
    max-width: 640px;
    opacity: 0;
    animation:
      drop-in 1000ms ease-out forwards,
      fade-in 2000ms ease-out forwards;
  }
</style>
