---
import LatestBlogPosts from '../views/LatestBlogPosts.astro';
import Home from '../views/Home.astro';
import About from '../views/About.astro';
import Services from '../views/Services.astro';
import Faqs from '../views/FAQS.astro';
import Skills from '../views/Skills.astro';
import Projects from '../views/Projects.astro';
---

<deific-cta>
  <kemet-button link="/consultation" rounded="pill">Contact me to get started</kemet-button>
</deific-cta>
<deific-socials></deific-socials>

<Home />
<About />
<Services />
<Faqs />
<Projects />
<LatestBlogPosts postsToShow={3} />
<Skills />

<deific-background></deific-background>
<style>
  deific-cta {
    position: fixed;
    top: 2rem;
    right: 2rem;
    z-index: 9999;

    kemet-button {
      --kemet-button-background-color: var(--color-primary);
      font-weight: bold;
      text-transform: uppercase;
      text-shadow: 1px 1px #000000aa;
    }
  }




  .view {
    display: flex;
    padding: 1rem;
    width: 100%;
    height: calc(100vh - 230px);
    scroll-snap-align: start;
    text-align: center;
    position: relative;

    & > * {
      width: 100%;
      height: 100%;
      margin: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;

      @media (min-width: 1024px) {
        padding: 2rem;
      }
    }

    h2 {
      font-size: clamp(1rem, 5vw, 2rem);
      white-space: nowrap;
      margin: 0;
      line-height: 1;

      span {
        display: block;
        font-size: 0.5em;
        opacity: 0.5;
      }
    }
  }



</style>
