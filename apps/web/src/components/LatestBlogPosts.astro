---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

const { postsToShow = 3 } = Astro.props;

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<deific-blog>
  {
    posts.map((post, index) => {
      if (index >= postsToShow) return null;
      const bannerImage = post.data.banner ?? '';
      return (
        <deific-blog-post slot={`slide-${index}`}>
          <h3>{post.data.title}</h3>
          <span class="date">
            <kemet-icon-bootstrap icon="calendar"></kemet-icon-bootstrap>&nbsp;&nbsp;
            <FormattedDate date={post.data.date} />
          </span>
          {bannerImage && <img src={bannerImage} alt={post.data.title} />}
          <div class="action">
            <p>{post.data.excerpt}</p>
            <kemet-button rounded="pill" link={`/blog/${post.id}/`}>
              Read More
              <kemet-icon-bootstrap icon="chevron-right" slot="right"></kemet-icon-bootstrap>
            </kemet-button>
          </div>
        </deific-blog-post>
      );
    })
  }
</deific-blog>
<kemet-button rounded="pill" variant="outlined" link="/blog/" polarity="dark">
  <kemet-icon-bootstrap icon="chevron-right" slot="right"></kemet-icon-bootstrap>
  View All Posts
</kemet-button>
<style>
  deific-blog {
    scroll-snap-align: start;
    [slot] {
      display: grid;
    }

    h3 {
      font-size: 2rem;
      padding: 0;
      margin: 0;
      max-width: 50vw;
    }

    img {
      width: auto;
      max-height: 33vh;
    }

    .date {
      display: inline-flex;
      font-size: 0.9rem;
      align-items: center;
      margin-bottom: 1rem;
    }

    .action {
      display: grid;
      gap: 2rem;
      align-items: center;
      grid-template-columns: 1fr auto;
      margin-top: 1rem;
      max-width: 50vw;

      p {
        font-size: 1.1rem;
        text-align: justify;
      }
    }
  }
</style>

